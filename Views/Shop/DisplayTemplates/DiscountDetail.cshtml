@model AspKnP231.Data.Entities.DiscountDetail

<div class="row border rounded m-2 p-2">
    <div class="col-4">
        <b>Товар:</b> @Model.Product.Title
    </div>
    <div class="col-3">
        <b>Акція:</b> @Model.Discount.Title
    </div>
    <div class="col-2">
        <b>Ціна:</b> @(Model.Price?.ToString("0.00") ?? "-")
    </div>
    <div class="col-3">
        <small class="text-muted">
            @(Model.Discount.StartMoment.ToString("dd.MM.yyyy HH:mm"))
            -
            @(Model.Discount.FinishMoment?.ToString("dd.MM.yyyy HH:mm") ?? "безстроково")
        </small>
    </div>
</div>