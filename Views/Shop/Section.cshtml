@model AspKnP231.Models.Shop.ShopSectionViewModel

<div class="row">
    <div class="col col-2 border-end">
        @foreach (var shopSection in Model.ShopSections)
        {
            <a href="/Shop/Section/@shopSection.Slug" class="d-block mb-2">
                @shopSection.Title
            </a>
        }
    </div>

    <div class="col col-10">
        <div class="text-center">
            <h1 class="display-4">
                @(Model.ShopSection == null ? "Розділ не знайдено" : Model.ShopSection.Title)
            </h1>
        </div>

        @if (Model.ShopSection != null)
        {
            <div class="row row-cols-sm-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5 g-4">
                @foreach (var product in Model.ShopSection.Products)
                {
                    @Html.DisplayFor(m => product)
                }
            </div>
        }
    </div>
</div>

